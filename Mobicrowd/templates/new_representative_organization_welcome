<!DOCTYPE html>
<html lang="en" style="background:#ffffff;">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="x-apple-disable-message-reformatting">
    <title>Takleef — Welcome Representative</title>
    <style>
      body{margin:0;padding:0;background:#ffffff;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
      table{border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt}
      img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;display:block}
      a{text-decoration:none}

      .container{width:100%;max-width:100%;margin:0 auto;padding:0}
      .card{width:100%;background:#ffffff;border:1px solid #e9eef5;border-radius:14px;overflow:hidden}
      .inner{padding:28px}
      .header-bar{background:#ffffff;border-bottom:1px solid #edf2f7;padding:16px 20px;text-align:center}
      .header-bar img{margin:0 auto;}

      .h1{margin:0;color:#083865;font:800 24px/1.35 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
      .lead{margin:0;color:#324556;font:15px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
      .small{margin:0;color:#6b7a88;font:13px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}

      .btn-wrap{text-align:center}
      .btn{
        display:inline-block;
        background:#1c86c3;
        color:#ffffff !important;
        border-radius:8px;
        padding:12px 20px;
        font:700 14px/1.2 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      }

      .box{
        background:#f8fbfe;
        border:1px solid #e6eef6;
        border-radius:10px;
        padding:16px 18px;
      }

      .label{
        color:#6b7a88;
        font:600 12px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
        text-transform:uppercase;
        letter-spacing:.3px;
        margin:0 0 4px 0;
      }

      .value{
        color:#083865;
        font:700 15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
        margin:0;
        word-break:break-word;
      }

      .sp12{height:12px;line-height:12px;font-size:12px}
      .sp16{height:16px;line-height:16px;font-size:16px}
      .sp20{height:20px;line-height:20px;font-size:20px}
      .sp24{height:24px;line-height:24px;font-size:24px}

      .center{text-align:center}
      .left{text-align:left}

      @media (max-width:480px){
        .inner{padding:22px}
        .h1{font-size:20px}
        .lead{font-size:14px}
      }
      /*[if mso]>*/.h1,.lead,.small,.btn,.label,.value{font-family:Arial,sans-serif!important}
    </style>
  </head>
  <body>
    <div style="display:none!important;visibility:hidden;mso-hide:all;font-size:1px;line-height:1px;color:transparent;opacity:0;height:0;width:0;overflow:hidden;">
      Welcome to Takleef. Your representative account and organization have been updated.
    </div>

    <table role="presentation" width="100%" bgcolor="#ffffff">
      <tr>
        <td align="center">
          <div class="container">

            <table role="presentation" class="card">
              <tr>
                <td class="header-bar">
                  <img src="cid:logo" width="160" alt="Takleef">
                </td>
              </tr>

              <tr>
                <td class="inner">
                  <h1 class="h1">Dear {{ full_name }},</h1>
                  <div class="sp16"></div>

                  <p class="lead">
                    Welcome to <strong>Takleef</strong>! You have been assigned as the representative of
                    <strong>{{ organization_name }}</strong>.
                  </p>

                  <div class="sp12"></div>

                  {% if show_account_activation %}
                    <p class="lead">
                      A separate email has been sent to you to set your password securely before your first sign-in.
                      After setting your password, please click <strong>Activate Account</strong> below.
                    </p>
                  {% else %}
                    <p class="lead">
                      Your requester account already exists and is ready to use.
                    </p>
                  {% endif %}

                  <div class="sp20"></div>

                  <div class="box">
                    <p class="label">Email</p>
                    <p class="value">{{ email }}</p>
                  </div>

                  <div class="sp20"></div>

                  {% if show_account_activation %}
                    <p class="lead">
                      To get started, please activate your account using the button below.
                    </p>

                    <div class="sp16"></div>

                    <p class="btn-wrap">
                      <a href="{{ account_activation_url }}" class="btn">Activate Account</a>
                    </p>

                    <div class="sp16"></div>
                  {% endif %}

                  {% if show_organization_activation %}
                    <div class="box">
                      <p class="label">Organization Activation</p>
                      <p class="small" style="margin:0; color:#324556;">
                        To activate your organization, please sign in with this account, switch to
                        <strong>Organization Mode</strong>, and then click
                        <strong>Activate Organization</strong> from the platform.
                      </p>
                    </div>
                  {% else %}
                    <div class="box">
                      <p class="label">Organization Access</p>
                      <p class="small" style="margin:0; color:#324556;">
                        This organization is already active. Please sign in with this account,
                        switch to <strong>Organization Mode</strong>, and access your organization directly from the platform.
                      </p>
                    </div>
                  {% endif %}

                  <div class="sp16"></div>

                  {% if show_account_activation %}
                    <p class="small center">
                      Please set your password from the separate email first, then activate your account using the button above.
                    </p>

                    <div class="sp16"></div>
                  {% endif %}

                  <p class="small center">
                    If you have any questions or need assistance, contact our support team at
                    <a href="mailto:takleefinc@gmail.com" style="color:#1c86c3;">takleefinc@gmail.com</a>.
                  </p>

                  <div class="sp24"></div>

                  <p class="small left" style="color:#324556;">
                    Best regards,<br>
                    <strong style="color:#083865;">Takleef</strong>
                  </p>
                </td>
              </tr>
            </table>

            <div class="sp24"></div>

          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
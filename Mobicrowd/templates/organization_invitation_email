<!DOCTYPE html>
<html lang="en" style="background:#ffffff;">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="x-apple-disable-message-reformatting">
    <title>Takleef — Organization Invitation</title>
    <style>
      body{margin:0;padding:0;background:#ffffff;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
      table{border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt}
      img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;display:block}
      a{text-decoration:none}

      .container{width:100%;max-width:100%;margin:0 auto;padding:0}
      .card{width:100%;background:#ffffff;border:1px solid #e9eef5;border-radius:14px;overflow:hidden}
      .inner{padding:28px}
      .header-bar{background:#ffffff;border-bottom:1px solid #edf2f7;padding:16px 20px;text-align:center}
      .header-bar img{margin:0 auto;}

      .h1{margin:0;color:#083865;font:800 24px/1.35 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
      .lead{margin:0;color:#324556;font:15px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
      .small{margin:0;color:#6b7a88;font:13px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}

      .btn{
        display:inline-block;
        padding:12px 18px;
        background:#0d6efd;
        color:#ffffff !important;
        text-decoration:none;
        border-radius:6px;
        font:600 14px/1.2 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      }

      .note{
        margin-top:24px;
        padding:14px 16px;
        background:#f8fafc;
        border:1px solid #e5edf5;
        border-radius:10px;
        color:#555;
        font:14px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      }

      .sp12{height:12px;line-height:12px;font-size:12px}
      .sp16{height:16px;line-height:16px;font-size:16px}
      .sp24{height:24px;line-height:24px;font-size:24px}

      .center{text-align:center}
      .left{text-align:left}

      @media (max-width:480px){
        .inner{padding:22px}
        .h1{font-size:20px}
        .lead{font-size:14px}
      }

      /*[if mso]>*/.h1,.lead,.small,.btn,.note{font-family:Arial,sans-serif!important}
    </style>
  </head>
  <body>
    <div style="display:none!important;visibility:hidden;mso-hide:all;font-size:1px;line-height:1px;color:transparent;opacity:0;height:0;width:0;overflow:hidden;">
      You have been invited to join {{ organization_name }} on Takleef.
    </div>

    <table role="presentation" width="100%" bgcolor="#ffffff">
      <tr>
        <td align="center">
          <div class="container">
            <table role="presentation" class="card">
              <tr>
                <td class="header-bar">
                  <img src="cid:logo" width="160" alt="Takleef">
                </td>
              </tr>

              <tr>
                <td class="inner left">
                  <h1 class="h1">Hello,</h1>
                  <div class="sp16"></div>

                  <p class="lead">
                    You have been invited by <strong>{{ invited_by_name }}</strong>
                    to join the organization <strong>{{ organization_name }}</strong>
                    as a <strong>{{ role_label }}</strong>.
                  </p>


                  <div class="sp16"></div>
                  <p class="lead">
                    This invitation will expire on <strong>{{ expires_at }}</strong>.
                  </p>

                  <div class="sp24"></div>
                  <div class="center">
                    <a
                      href="{{ invitation_url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn"
                    >
                      View Invitation
                    </a>
                  </div>

                  <div class="note">
                    <strong>Important:</strong>
                    <br>- If you already have an account, please sign in using the invited email address
                    <br>- If you do not have an account yet, please create one and then return to the invitation
                    <br>- No membership will be created automatically without your confirmation
                  </div>
                </td>
              </tr>
            </table>

            <div class="sp24"></div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>